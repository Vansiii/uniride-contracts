{
  "name": "uniride-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat build",
    "test": "hardhat test",
    "lint": "prettier --check \"contracts/**/*.sol\" \"test/**/*.ts\" \"ignition/**/*.ts\" hardhat.config.ts",
    "format": "prettier --write \"contracts/**/*.sol\" \"test/**/*.ts\" \"ignition/**/*.ts\" hardhat.config.ts",
    "nodo": "hardhat node",
    "desplegar:local": "hardhat ignition deploy ignition/modules/UniRide.ts --network localhost",
    "desplegar:amoy": "hardhat ignition deploy ignition/modules/UniRide.ts --network amoy"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.12",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.1",
    "@nomicfoundation/hardhat-mocha": "^4.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.11",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@nomicfoundation/hardhat-verify": "^3.1.2",
    "@nomicfoundation/ignition-core": "^3.1.10",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.19.2",
    "chai": "^6.3.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.19.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-solidity": "^2.4.1",
    "typescript": "~5.9"
  }
}
